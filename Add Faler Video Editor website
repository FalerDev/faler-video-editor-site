:root {
  --bg: #05070a;
  --panel: #0b1015;
  --panel-2: #0f151c;
  --border: #26313b;
  --text: #f4f7f9;
  --muted: #87939e;
  --muted-2: #65717c;
  --accent: #e9f2f8;
  --success: #70f59a;
  --max: 1060px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background:
    radial-gradient(circle at 80% -10%, rgba(133, 175, 205, 0.12), transparent 34rem),
    radial-gradient(circle at 10% 110%, rgba(210, 225, 238, 0.06), transparent 28rem),
    var(--bg);
  color: var(--text);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  line-height: 1.65;
}

a {
  color: var(--accent);
  text-decoration: none;
}
a:hover { text-decoration: underline; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(18px);
  background: rgba(5, 7, 10, 0.84);
  border-bottom: 1px solid rgba(38, 49, 59, 0.75);
}

.nav {
  width: min(calc(100% - 32px), var(--max));
  margin: 0 auto;
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  font-weight: 800;
  letter-spacing: -0.02em;
}

.brand:hover { text-decoration: none; }

.logo {
  width: 38px;
  height: 38px;
  border-radius: 13px;
  border: 1px solid #41505d;
  background: linear-gradient(145deg, #121a21, #07090c);
  display: grid;
  place-items: center;
  box-shadow: 0 0 30px rgba(205, 232, 250, 0.08);
  font-weight: 900;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
  font-size: 14px;
  color: var(--muted);
}

.nav-links a { color: var(--muted); }
.nav-links a:hover { color: var(--text); }

.hero {
  width: min(calc(100% - 32px), var(--max));
  margin: 0 auto;
  padding: 112px 0 86px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 11px;
  border: 1px solid #2a3741;
  border-radius: 999px;
  color: #aebac4;
  background: rgba(11, 16, 21, 0.7);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 16px rgba(112, 245, 154, 0.45);
}

h1 {
  max-width: 820px;
  margin: 24px 0 18px;
  font-size: clamp(42px, 8vw, 78px);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.hero p {
  max-width: 700px;
  margin: 0;
  color: var(--muted);
  font-size: 18px;
}

.actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 32px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 14px;
  border: 1px solid #34414c;
  background: #f0f5f8;
  color: #07090b;
  font-weight: 800;
  font-size: 13px;
}

.button.secondary {
  background: #0b1015;
  color: var(--text);
}

.button:hover {
  text-decoration: none;
  transform: translateY(-1px);
}

.grid {
  width: min(calc(100% - 32px), var(--max));
  margin: 0 auto 88px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.card {
  min-height: 200px;
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(15, 21, 28, 0.95), rgba(8, 12, 16, 0.96));
}

.card .num {
  font-size: 12px;
  color: var(--muted-2);
  font-weight: 800;
  letter-spacing: 0.12em;
}

.card h2 {
  margin: 30px 0 10px;
  font-size: 19px;
  letter-spacing: -0.02em;
}

.card p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.legal-wrap {
  width: min(calc(100% - 32px), 860px);
  margin: 0 auto;
  padding: 76px 0 100px;
}

.legal-card {
  border: 1px solid var(--border);
  border-radius: 26px;
  background: rgba(11, 16, 21, 0.92);
  padding: clamp(24px, 5vw, 48px);
}

.legal-card h1 {
  font-size: clamp(36px, 6vw, 58px);
  margin-top: 10px;
}

.meta {
  color: var(--muted-2);
  font-size: 13px;
  margin-bottom: 34px;
}

.legal-card h2 {
  margin-top: 34px;
  font-size: 20px;
  letter-spacing: -0.02em;
}

.legal-card p, .legal-card li {
  color: #a9b3bc;
  font-size: 14px;
}

.notice {
  border: 1px solid #32403a;
  background: #0d1711;
  border-radius: 16px;
  padding: 16px;
  color: #bde8c9;
  font-size: 13px;
}

footer {
  border-top: 1px solid var(--border);
  color: var(--muted-2);
}

.footer-inner {
  width: min(calc(100% - 32px), var(--max));
  min-height: 94px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  font-size: 12px;
}

.footer-links {
  display: flex;
  gap: 16px;
}

@media (max-width: 760px) {
  .nav-links { gap: 12px; font-size: 12px; }
  .hero { padding-top: 78px; }
  .grid { grid-template-columns: 1fr; }
  .footer-inner { flex-direction: column; justify-content: center; padding: 24px 0; }
}

